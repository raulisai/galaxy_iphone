{
  "schema": "wristbridge.p2-framing-vectors",
  "version": "draft-2",
  "status": "PROPUESTO",
  "note": "Vectores de framing SIN cifrado, derivados a mano (cabecera 9 bytes + totalLength u32 en el primer frame). Ninguno se obtuvo ejecutando el codec bajo prueba. Borrador P2 no congelado; no es un contrato.",
  "layout": "frameVersion u8 | type u8 | flags u8 | messageId u16 | fragIndex u16 | fragCount u16 | [totalLength u32 solo en fragIndex 0 de DATA/HANDSHAKE] | payload. Big-endian. Los espacios del hex son solo separadores.",
  "schemas": {
    "p2.frame": "bytesHex es un unico valor ATT; expected.outcome = frame | error | ignored.",
    "p2.stream": "framesHex son valores ATT en orden; expected.steps lista un resultado por frame (partial, complete, error:NOMBRE, cancelled, cancel-noop, ack:known, ack:unknown, ignored, peer-error:CODIGO:RELACIONADO).",
    "p2.encode": "context.encode describe la entrada del codificador; expected es un error esperado."
  },
  "contextKeys": {
    "limitsUniform": "los tres limites de totalLength valen N",
    "knownMaxAttValueBytes": "el receptor conoce la capacidad y exige primer frame = max-13",
    "timesMs": "instante monotono de cada frame en ms (por defecto 0)",
    "outboundInFlight": "messageId enviados sin ACK",
    "encode": "si existe en un p2.stream, el codificador debe reproducir framesHex exactamente"
  },
  "vectors": [
